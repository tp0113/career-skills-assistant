# Copy to .env and edit. .env is git-ignored. Every value here has a default in app/config.py.

# Model provider. "ollama" (local) is the only one built; a hosted backup was planned and not needed (F21).
LLM_PROVIDER=ollama

# Ollama (local). Use the native endpoint; num_ctx is sent on every request.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
# Embedding model for the semantic router (ollama pull nomic-embed-text), and "off" to use keyword rules only.
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_ROUTER=on
# Keeps the model loaded between requests (read by the Ollama server, not by this app).
OLLAMA_KEEP_ALIVE=2h

# Data and runtime files
DATA_DIR=data
ENROLLMENTS_PATH=var/enrollments.json
REQUEST_LOG_PATH=logs/requests.jsonl

# Prompt-injection defense: "on" (default) or "off" (only for the before/after demo).
INJECTION_DEFENSE=on
